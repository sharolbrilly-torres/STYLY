rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'matematicaslzda@gmail.com' ||
        (exists(/databases/database/documents/users/$(request.auth.uid)) &&
         get(/databases/database/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Products: readable by everyone, manageable by admin or app seeder
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allow client/admin updates for catalog
    }

    // Orders: allow customer creation, read own or admin
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // PQRS tickets: allow creation and reading by creator or admin
    match /pqrs/{ticketId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
